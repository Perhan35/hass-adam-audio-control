#!/usr/bin/env bash
# Start a throwaway Home Assistant instance on port 8456.
#
# The config dir (config_fresh/) is deleted and rebuilt on every launch, so the
# integration is always exercised against a brand-new install. Runs alongside
# scripts/develop (config/, port 8123) without interfering with it.
#
# Usage:
#   scripts/develop_fresh              # confirm the wipe, then start HA
#   scripts/develop_fresh -y           # wipe without asking
#   scripts/develop_fresh -u           # upgrade dependencies first, then start
#   scripts/develop_fresh --reset-only # wipe + seed, don't start HA

set -e

cd "$(dirname "$0")/.."

# shellcheck source=scripts/_venv.sh
source scripts/_venv.sh

PORT=8456
USERNAME=dev
PASSWORD=dev
# Never taken from an argument: rm -rf below must only ever hit this path.
CONFIG_DIR="${PWD}/config_fresh"

FORCE=0
RESET_ONLY=0
UPDATE=0

for arg in "$@"; do
    case "$arg" in
        -y|--force) FORCE=1 ;;
        --reset-only) RESET_ONLY=1 ;;
        -u|--update) UPDATE=1 ;;
        -h|--help)
            sed -n '2,13p' "$0"
            exit 0
            ;;
        *)
            echo "Unknown option: $arg" >&2
            exit 1
            ;;
    esac
done

if [[ "$UPDATE" -eq 1 ]]; then
    echo "Upgrading dependencies (Home Assistant included)..."
    scripts/setup --upgrade
fi

if [[ -d "$CONFIG_DIR" && "$FORCE" -eq 0 ]]; then
    if [[ ! -t 0 ]]; then
        echo "config_fresh/ exists and there is no terminal to confirm on; pass -y." >&2
        exit 1
    fi
    read -r -p "Delete config_fresh/ and start from scratch? [y/N] " reply
    if [[ ! "$reply" =~ ^[yY]$ ]]; then
        echo "Aborted."
        exit 1
    fi
fi

rm -rf "$CONFIG_DIR"
mkdir -p "$CONFIG_DIR"

hass --config "$CONFIG_DIR" --script ensure_config

cat > "$CONFIG_DIR/configuration.yaml" <<EOF
# Home Assistant configuration for testing ADAM Audio integration.
# Generated by scripts/develop_fresh — this file is recreated on every launch.
# Replace default_config with only what we need to avoid Bluetooth crashing the zeroconf autodiscovery.
frontend:
api:
zeroconf:

http:
  server_port: ${PORT}

logger:
  default: info
  logs:
    custom_components.adam_audio: debug

lovelace:
  mode: storage
EOF

# This let's us have the structure we want <root>/custom_components/adam_audio
# while at the same time have Home Assistant configuration inside
# <root>/config_fresh without resorting to symlinks.
export PYTHONPATH="${PWD}:${PWD}/custom_components"

python3 scripts/seed_onboarding.py "$CONFIG_DIR" "$USERNAME" "$PASSWORD"

HA_VERSION=$(cat "$CONFIG_DIR/.HA_VERSION" 2>/dev/null || echo "unknown")

echo ""
echo "============================================================"
echo "  FRESH HOME ASSISTANT INSTANCE"
echo "  VERSION  : ${HA_VERSION}"
echo "  URL      : http://localhost:${PORT}"
echo "  USERNAME : ${USERNAME}"
echo "  PASSWORD : ${PASSWORD}"
echo "============================================================"
echo ""

if [[ "$RESET_ONLY" -eq 1 ]]; then
    exit 0
fi

# HA's zeroconf browser asks for 100+ service types in one batched, compressed
# query, which the ADAM Audio speakers' embedded mDNS responder doesn't
# reliably answer — but it does answer a clean, single-type query within about
# a second. Run that dedicated query alongside HA's own startup so its
# passively-listening socket picks up the response immediately instead of
# waiting on a lucky compound-query hit (which can take several minutes).
python3 scripts/nudge_zeroconf.py &
NUDGE_PID=$!
trap 'kill "$NUDGE_PID" 2>/dev/null' EXIT

hass --config "$CONFIG_DIR" --debug
